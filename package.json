{
  "name": "agent-voucher",
  "version": "0.1.0",
  "description": "Local-first accounting workspace foundation",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "agent-voucher": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "modules/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:assets && tsup",
    "dev": "tsx src/cli.ts start --no-open --data-dir ./.local-data",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:load": "tsx scripts/load-foundation.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:architecture && npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^11.1.1",
    "@langchain/langgraph": "^1.0.12",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.0",
    "@tabler/core": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.1",
    "eta": "^4.4.1",
    "fastify": "^5.6.2",
    "htmx.org": "^2.0.8",
    "open": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
